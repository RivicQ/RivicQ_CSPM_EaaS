{
  "name": "rivic-q-runtime",
  "version": "1.0.0",
  "description": "Quantum-Safe Cloud-Native Infrastructure for EU Banking",
  "main": "dist/operator/rivic-operator.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"npm run dev:operator\" \"npm run dev:website\" \"npm run dev:monitoring\" \"npm run dev:gateway\"",
    "dev:operator": "RIVIC_ENV=development RIVIC_EDITION=enterprise ts-node src/operator/rivic-operator.ts",
    "dev:operator:oss": "RIVIC_ENV=development RIVIC_EDITION=opensource ts-node src/operator/rivic-operator.ts",
    "dev:website": "node saas-website/server.js",
    "dev:demo": "ts-node demo-banking-app/app.ts",
    "dev:monitoring": "node monitoring/server.js",
    "dev:gateway": "node api-gateway.js",
    "demo:start": "ts-node demo-banking-app/app.ts",
    "demo:build": "tsc demo-banking-app/app.ts --outDir dist/demo",
    "saas:start": "node saas-website/server.js",
    "saas:dev": "nodemon saas-website/server.js",
    "start:all": "concurrently \"npm run demo:start\" \"npm run saas:start\"",
    "prod:deploy": "RIVIC_ENV=production RIVIC_EDITION=enterprise npm run build && npm run docker:build && npm run k8s:deploy",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=\\.unit\\. --coverage",
    "test:integration": "jest --testPathPattern=\\.integration\\.",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t rivic/q-runtime:v1.0.0 .",
    "docker:build-agent": "docker build --target agent -t rivic/q-runtime-agent:v1.0.0 .",
    "docker:build-oss": "docker build -t rivic/q-runtime-oss:v1.0.0 --build-arg EDITION=opensource .",
    "k8s:deploy": "kubectl apply -f k8s/manifests.yaml",
    "k8s:deploy:oss": "kubectl apply -f k8s/manifests-oss.yaml",
    "k8s:undeploy": "kubectl delete -f k8s/manifests.yaml --ignore-not-found",
    "deploy:local": "npm run build && npm run docker:build && npm run k8s:deploy",
    "deploy:local:oss": "npm run build && npm run docker:build-oss && npm run k8s:deploy:oss",
    "cbom:generate": "ts-node -e \"import {CBOMGenerator} from './src/cbom/generator'; const gen = new CBOMGenerator(); gen.generateBuildTimeCBOM('.').then(console.log)\"",
    "cbom:audit": "ts-node -e \"import {CBOMGenerator} from './src/cbom/generator'; const gen = new CBOMGenerator(); gen.generateComplianceAudit().then(console.log)\"",
    "start": "node dist/operator/rivic-operator.js",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "quantum-safe",
    "post-quantum-cryptography",
    "kubernetes",
    "banking",
    "eidas",
    "dora",
    "cbom",
    "compliance"
  ],
  "author": "Rivic Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rivic-q/cryptobom-saas.git"
  },
  "homepage": "https://rivic-q.github.io/cryptobom-saas/",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^25.0.3",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "body-parser": "^2.2.1",
    "express": "^5.2.1",
    "jsonschema": "^1.5.0"
  }
}
