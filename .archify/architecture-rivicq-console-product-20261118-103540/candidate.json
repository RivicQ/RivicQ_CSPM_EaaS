  "cards": [
    {
      "dot": "cyan",
      "title": "Where work starts",
      "items": [
        "The product console exposes public routes and protected scanner, findings, and BOM views.",
        "RevenueOS is a separate commerce desk with its own session gate.",
        "CLI and GitHub Action use the same scan contract without a browser."
      ]
    },
    {
      "dot": "emerald",
      "title": "What the engine actually does",
      "items": [
        "POST /scans validates the target, normalizes tenant, and returns 202 with a result URL.",
        "The manager runs target scanners under a 120-second timeout and persists completed reports.",
        "Intelligence evaluates findings before a CycloneDX-compatible CBOM is delivered."
      ]
    },
    {
      "dot": "rose",
      "title": "Edition boundary",
      "items": [
        "Community covers the shared scanner, CBOM, policy, and CLI gate.",
        "QBOM, HSM, SSO, audit, and advanced BOM layers require Enterprise.",
        "Control mappings are evidence mappings, not certifications."
      ]
    }
  ]
