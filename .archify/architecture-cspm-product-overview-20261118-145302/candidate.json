  "cards": [
    {
      "dot": "cyan",
      "title": "What the product shows",
      "items": [
        "Public Home, Product, and CSPM pages explain the system before asking for a session.",
        "The console exposes dashboard, scans, findings, assets, settings, and role-gated admin views.",
        "MFA setup and disable require a live API session; demo mode never stores TOTP secrets."
      ]
    },
    {
      "dot": "emerald",
      "title": "What the engine actually does",
      "items": [
        "POST /scans validates the target, normalizes tenant scope, and returns 202 with a result URL.",
        "The manager runs target scanners under a 120-second timeout and persists completed reports.",
        "Intelligence evaluates findings before a CycloneDX-compatible CBOM is delivered."
      ]
    },
    {
      "dot": "rose",
      "title": "Where trust is enforced",
      "items": [
        "Client edition switches are ignored; /auth/me is authoritative for identity and entitlement.",
        "Unmapped mutations fail closed; Reads stay tenant-scoped.",
        "Enterprise requires a valid license and configured database; unconfigured capabilities stay unavailable."
      ]
    }
  ]
