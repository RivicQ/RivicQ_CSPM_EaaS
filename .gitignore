# Ignore binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
/bin/
/dist/
/tmp/

# Secrets
*.env
.env.local
.env.production
secrets/
*.pem
*.key

# Logs
*.log

# Docker
.dockerignore

# Kubernetes
*.kubeconfig

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Helm
*.tgz
crds/

# Coverage
coverage.txt
coverage.html

# Local development
local-dev/
kind-cluster/
minikube/
# Frontend build artifacts
web/build/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.terraform.lock.hcl
