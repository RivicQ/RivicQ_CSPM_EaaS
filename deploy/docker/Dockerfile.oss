FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X main.version=latest -X main.edition=oss" \
    -o /app/cryptobom-oss \
    ./cmd/server/oss/main.go

FROM alpine:3.18

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/cryptobom-oss /app/cryptobom-server
COPY deploy/docker/wait-for-migrate.sh /app/wait-for-migrate.sh
RUN chmod +x /app/wait-for-migrate.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["/app/wait-for-migrate.sh"]
