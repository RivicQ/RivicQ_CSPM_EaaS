FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X main.version=latest -X main.edition=enterprise" \
    -tags enterprise \
    -o /app/cryptobom-enterprise \
    ./cmd/server/enterprise/main.go

FROM alpine:3.18

RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app

COPY --from=builder /app/cryptobom-enterprise /app/cryptobom-server

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD wget -qO- http://localhost:9090/healthz || exit 1

CMD ["/app/cryptobom-server"]
