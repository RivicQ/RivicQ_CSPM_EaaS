# CryptoBOM OSS – environment variable reference
# Copy this file to .env and fill in values for your local setup.
# Lines beginning with # are comments; the values shown are defaults.
#
# NEVER commit a .env file that contains real secrets.
#
# Quickstart:  make dev   (starts db + migrations + backend + frontend)

# ── Server ─────────────────────────────────────────────────────────────────
# Listening port for the OSS API server.
CRYPTOBOM_PORT=8080

# Log level: debug | info | warn | error
CRYPTOBOM_LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# Password used by the local Docker Compose PostgreSQL container.
# The full DATABASE_URL is built automatically by docker-compose.yml.
# If running the Go binary directly, set DATABASE_URL below instead.
DB_PASSWORD=cryptobom_dev

# Leave blank to use the in-memory/demo mode (no persistence).
# Set to your local Postgres URL when running the binary outside Docker:
#   DATABASE_URL=postgres://cryptobom:cryptobom_dev@localhost:5432/cryptobom?sslmode=disable
DATABASE_URL=

# ── Cilium / eBPF asset discovery (optional) ──────────────────────────────
# Set CILIUM_ENABLED=false to disable the eBPF discovery sidecar.
CILIUM_ENABLED=false
CILIUM_ENDPOINT=localhost:8081
# CILIUM_API_TOKEN=

# ── JWT auth secret ────────────────────────────────────────────────────────
# Used to sign and verify JWT tokens.  Change this before going to production.
JWT_SECRET=change-me-in-production

# ── Frontend (web) ────────────────────────────────────────────────────────
# URL the React frontend will use to reach the backend API.
REACT_APP_API_URL=http://localhost:8080
