# ── Edition ─────────────────────────────────────────────────────────────
# Set to "ENT-<your-key>" to enable Enterprise features (port 9090).
# Omit or leave empty for OSS edition (port 8080).
# CRYPTOBOM_LICENSE_KEY=ENT-demo-key

# ── Server ───────────────────────────────────────────────────────────────
# Override the default port (OSS=8080, Enterprise=9090).
# CRYPTOBOM_PORT=8080

# ── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED for auth endpoints (/auth/login, /auth/register, /auth/me) in both editions.
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-random-64-char-string

# Optional: restrict registration to specific email domains (comma-separated).
# Leave blank for open-source installs so anyone can register.
# AUTH_ALLOWED_DOMAINS=rivicq.de,rivicq.com

# Bootstrap admin user (created on first startup when auth routes are enabled).
# Local demo users (see docs/DEMO_CREDENTIALS.md):
#   Enterprise admin    revan.ande@rivicq.de / DemoPass123!
#   Professional oper.  pratik.rughe@rivicq.de / DemoPass123!
#   Analyst             danush.m@rivicq.de    / DemoPass123!
#   Community viewer    sales@rivicq.de       / DemoPass123!
AUTH_BOOTSTRAP_EMAIL=admin@rivicq.local
AUTH_BOOTSTRAP_PASSWORD=change-me
AUTH_BOOTSTRAP_NAME=OSS Admin
AUTH_BOOTSTRAP_ROLE=admin

# ── Database ─────────────────────────────────────────────────────────────
# Without these, the server runs in demo mode (in-memory, ephemeral data).
# OSS edition defaults to: sqlite:///tmp/cryptobom-oss.db
# Enterprise edition defaults to: postgresql://user:pass@localhost:5432/cryptobom_enterprise

# DATABASE_URL=postgresql://cryptobom:password@localhost:5432/cryptobom_saas?sslmode=disable

# ── IBM Quantum (Enterprise only) ────────────────────────────────────────
# IBMQ_ENABLED=true
# IBMQ_API_KEY=
# IBMQ_ENDPOINT=https://quantum-computing.ibm.com/api
# IBMQ_NETWORK=ibm-q
# IBMQ_TIMEOUT=30

# ── ML Threat Detection (Enterprise only) ────────────────────────────────
# ML_ENABLED=true
# ML_MODEL_PATH=/opt/cryptobom/models
# ML_CONFIDENCE=0.85
# ML_THREAT_API=https://api.threatintel.cryptobom.io

# ── Multi-Cloud (Enterprise only) ────────────────────────────────────────
# AWS_ENABLED=false
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=us-east-1

# GCP_ENABLED=false
# GCP_PROJECT_ID=
# GCP_KEY_FILE=

# AZURE_ENABLED=false
# AZURE_SUBSCRIPTION=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ── SSO (Enterprise only) ────────────────────────────────────────────────
# SAML_ENABLED=false
# SAML_IDP_URL=
# SAML_CERT=

# LDAP_ENABLED=false
# LDAP_URL=ldap://localhost:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASS=
# LDAP_BASE_DN=ou=users,dc=example,dc=com

# Google OAuth — set these to enable "Sign in with Google" on the login page.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# GitHub OAuth — set these to enable "Sign in with GitHub" on the login page.
# GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# Optional frontend redirect target used to complete Google/GitHub OAuth.
# FRONTEND_REDIRECT_URL=http://localhost:3000

# GitHub Token — set this to enable GitHub repo scanning from the dashboard.
# GITHUB_TOKEN=your-github-personal-access-token

# ── Analytics (Enterprise only) ──────────────────────────────────────────
# ANALYTICS_ENABLED=true
# ANALYTICS_ML_PATH=/opt/cryptobom/analytics
# ANALYTICS_FORECAST_API=https://api.forecast.cryptobom.io

# ── Cilium / eBPF ────────────────────────────────────────────────────────
# CILIUM_ENDPOINT=localhost:8081

# ── Logging ──────────────────────────────────────────────────────────────
# CRYPTOBOM_LOG_LEVEL=info
